# ── Supabase ──────────────────────────────────────────────────────────────────
# Your project URL and public anon key (safe to expose client-side)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Paystack ──────────────────────────────────────────────────────────────────
# Public key from https://dashboard.paystack.com/#/settings/developers
# Safe to expose client-side (used to open the Paystack popup on checkout)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Secret key — used ONLY in Supabase Edge Functions, NEVER in the browser
# Add via: supabase secrets set PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# ── Firebase Cloud Messaging (optional — app works without it) ─────────────────
# Add via: supabase secrets set FCM_SERVER_KEY=...
FCM_SERVER_KEY=your-fcm-legacy-server-key

# ── Resend (order confirmation emails) ────────────────────────────────────────
# Get your key at https://resend.com → API Keys
# Add via: supabase secrets set RESEND_API_KEY=re_...
# Note: emails are skipped gracefully if this key is not set
RESEND_API_KEY=re_your_resend_api_key

# ── Firebase client config (only needed if using FCM push in the browser) ─────
VITE_FCM_VAPID_KEY=your-web-push-certificate-vapid-public-key
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
